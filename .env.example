# Shared Supabase project URL.
# Local Supabase (`supabase start`): Android emulator -> http://10.0.2.2:54321 (127.0.0.1 is the emulator itself),
# iOS simulator -> http://127.0.0.1:54321, physical phone -> http://<your Mac LAN IP>:54321.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). NEVER put the secret key in the client.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Data source on startup: "supabase" (default) or "mock" (forces demo mode, useful without a backend)
EXPO_PUBLIC_DATA_SOURCE=supabase
