# Copy to supabase/functions/.env (git-ignored) for `supabase functions serve --env-file`.
# Expo access token with "enhanced push security" (https://expo.dev/settings/access-tokens).
AGENDO_EXPO_ACCESS_TOKEN=
# Must match the Vault secret `agendo_reminders_cron_secret` (local seed uses this value).
AGENDO_REMINDERS_CRON_SECRET=local-dev-cron-secret
